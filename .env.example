# Telegram Bot Token (from @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated list of Telegram User IDs who have admin access
ADMIN_IDS=123456789

# Path to Google Service Account JSON key
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json

# Web App / API settings (for Telegram Mini App)
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Public HTTPS URL of the Mini App (e.g. https://your-server.com or ngrok URL for local dev)
WEBAPP_URL=https://example.com

# Database
DATABASE_PATH=data/autoposter.db

# [OPTIONAL] Telethon settings for native Telegram cloud scheduled messages
# Needed if you want Telegram to hold scheduled posts in its own cloud (100% server-downtime proof)
# Get from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELETHON_SESSION_NAME=data/admin_session
